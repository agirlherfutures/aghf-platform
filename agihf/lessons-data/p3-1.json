  "takeaways": [
    "Markets need counterparties: buyers and sellers.",
    "Obvious levels may attract resting orders: take-profits, stops, breakout and new orders.",
    "You can identify the area. You can’t know every participant’s motive."
  ],
  "remember": "Liquidity isn’t a secret trap. It’s where orders may be concentrated."
