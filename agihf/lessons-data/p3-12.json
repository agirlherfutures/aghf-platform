    {
      "type": "teach",
      "kicker": "Two words",
      "heading": "Imbalance ≠ FVG.",
      "body": "<strong>Imbalance</strong> is the broad idea: price delivered with little two-sided trading, usually a fast move with little overlap.<br><br>A <strong>fair value gap</strong> is one specific way traders measure a piece of it, using exactly three candles. You’ll build one next lesson.<br><br>Every FVG comes from imbalance. Not every imbalanced-looking move gets labeled an FVG.",
      "check": {
        "prompt": "Which is broader?",
        "options": [
          {
            "label": "Imbalance",
            "correct": true,
            "why": "Imbalance is the idea. An FVG is one specific measurement."
          },
          {
            "label": "FVG",
            "correct": false,
            "feedback": "An FVG is a specific three-candle pattern inside the broader idea."
          }
        ]
      }
    },
