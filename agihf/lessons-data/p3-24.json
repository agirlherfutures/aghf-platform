      "start": 33,
      "steps": [
        {
          "text": "Let’s ask this chart some questions. First: where’s the prior high?",
          "show": [
            "ph"
          ]
        },
        {
          "text": "Price pushed through it and a candle closed above it.",
          "show": [
            "close"
          ],
          "asks": [
            {
              "prompt": "CAN THE CHART ANSWER “DID PRICE CLOSE ABOVE THE HIGH?”",
              "options": [
                {
                  "label": "Yes. I can see it",
                  "correct": true,
                  "why": "That’s a question the chart answers perfectly."
                },
                {
                  "label": "No",
                  "correct": false,
                  "feedback": "Look at the close. It’s right there."
                }
              ],
              "concept": "chart-can-answer"
            }
          ]
        },
        {
          "text": "Now price pulled back and is holding above that old high.",
          "show": [
            "hold"
          ],
          "asks": [
            {
              "prompt": "CAN THE CHART ANSWER “WHO WAS BUYING?”",
              "options": [
                {
                  "label": "No. A chart shows price, not people",
                  "correct": true,
                  "why": "Exactly. Who, why and how many are not on a price chart."
                },
                {
                  "label": "Yes. Big banks",
                  "correct": false,
                  "feedback": "Nothing on this chart names a buyer.",
                  "mistake": "participant-identity-assumption"
                }
              ],
              "concept": "chart-cannot-answer"
            }
          ]
        }
      ],
      "kicker": "Ask the chart",
      "title": "What can this chart actually tell us?",
      "guided": true
    },
